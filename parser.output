Nonterminals, with rules where they appear

$accept (34)
    on left: 0
programa (35)
    on left: 1, on right: 0
lista_instrucciones (36)
    on left: 2 3, on right: 1 2 16 18 19 20 21 22
instruccion (37)
    on left: 4 5 6 7 8 9 10, on right: 2 3
declaracion (38)
    on left: 11 12 13, on right: 4 21 22
asignacion (39)
    on left: 14, on right: 5 22
asignacion_sin_q (40)
    on left: 15, on right: 21
condicional (41)
    on left: 16, on right: 6
bloques_alternativos (42)
    on left: 17 18 19, on right: 16 19
ciclo (43)
    on left: 20 21 22, on right: 7
lectura (44)
    on left: 23, on right: 8
escritura (45)
    on left: 24, on right: 9
condicion (46)
    on left: 25 26 27 28 29 30, on right: 16 19 20 21 22
expresion (47)
    on left: 31 32 33, on right: 14 15 24 25 26 27 28 29 30 31 32 37
termino (48)
    on left: 34 35 36, on right: 31 32 33 34 35
factor (49)
    on left: 37 38 39 40, on right: 34 35 36


state 0

    0 $accept: . programa $end

    TOKEN_COIN      shift, and go to state 1
    TOKEN_STAR      shift, and go to state 2
    TOKEN_PLAYER    shift, and go to state 3
    TOKEN_MUSHROOM  shift, and go to state 4
    TOKEN_WARP      shift, and go to state 5
    TOKEN_LEVEL     shift, and go to state 6
    TOKEN_BOX       shift, and go to state 7
    TOKEN_FLAG      shift, and go to state 8
    TOKEN_PIPE      shift, and go to state 9
    TOKEN_ID        shift, and go to state 10

    programa             go to state 11
    lista_instrucciones  go to state 12
    instruccion          go to state 13
    declaracion          go to state 14
    asignacion           go to state 15
    condicional          go to state 16
    ciclo                go to state 17
    lectura              go to state 18
    escritura            go to state 19


